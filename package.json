{
  "name": "airaptovideo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "metrics": "node scripts/metrics.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:check": "npm run cf:build && wrangler deploy --dry-run",
    "preview": "npm run cf:build && opennextjs-cloudflare preview --port 8788",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "heic-convert": "^2.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "wrangler": "4.156.2"
  }
}
