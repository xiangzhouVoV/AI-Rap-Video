# Canonical browser origin. Set this to the deployed HTTPS domain in production.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Turn on only after the real provider, legal pages and production content are ready.
INDEXABLE=false

# Use durable, private storage on a single Node.js server. Never expose this path.
# DATA_DIR=/absolute/private/path/airaptovideo

# Leave absent for an honestly labelled local sample flow (no AI or billing).
# This URL points to YOUR adapter implementing the docs/api.md contract.
# VIDEO_PROVIDER_URL=https://video-adapter.example.com/v1
# VIDEO_PROVIDER_KEY=
LIVE_GENERATION_ENABLED=false
FREE_VIDEO_MAX_COST_USD=0.50
PAID_VIDEO_MAX_COST_USD=1.50

# One-time credit packs only. Leave disabled until verified webhooks,
# credit accounting and actual HD delivery have been integrated.
# CHECKOUT_PROVIDER_URL=https://checkout-adapter.example.com/v1
# CHECKOUT_PROVIDER_KEY=
CHECKOUT_ENABLED=false

# Local same-origin proxy to the independent authentication Worker.
# Use http://localhost:3000 in the browser; keep it identical to BETTER_AUTH_URL.
# In Cloudflare production route /api/auth/* and /api/me to the backend Worker,
# and leave AUTH_BACKEND_URL unset (do not ship a localhost rewrite).
AUTH_BACKEND_URL=http://127.0.0.1:8787
